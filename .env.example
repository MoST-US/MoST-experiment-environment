
# Timeout (seconds) for endpoint model discovery before starting an experiment.
MODEL_DISCOVERY_TIMEOUT=10

# benchmark target: {vllm, tgis}
TARGET=vllm

# fraction of greedy requests
FRAC_GREEDY=1.0

# number of input requests to generate (virtual users will sample from these)
SAMPLE_SIZE=1

# use code prompts (rather than normal text)
CODE=false

# Default requests directory
REQUESTS_DIR=../../../../tokenized_prompts

# requests file
REQUESTS_FILENAME=sample_requests.json

# results directory
RESULTS_DIR=results

# results file
RESULTS_FILENAME=results.json

# filename for combined results
RESULTS_ALL_FILENAME=results_all.json

# number of virtual users
NUM_USERS=3

# number of virtual users
SWEEP_USERS=5

# if a request fails, we will backoff for some time
BACKOFF=1s

# we allow some grace period for requests to finish when experiment ends
GRACE_PERIOD=5s

# URL for inference server endpoint
# for vLLM this should look like: $(IP_ADDRESS):8000
# and for TGIS this should look like $(IP_ADDRESS):8033
URL=gpu05:9010

# --- Experiment automation configuration ---
# List of input/output token intervals to test
# Supported formats per entry:
# - in:out (single values)
# - inMin-inMax:out (input range)
# - in:outMin-outMax (output range)
# - inMin-inMax:outMin-outMax (both ranges)
#TOKENS_LIST=1-100:1-100,1-100:100-300,1-100:300-600,1-100:600-1000,1-100:1000-1500,100-300:1-100,100-300:100-300,100-300:300-600,100-300:600-1000,100-300:1000-1500,300-600:1-100,300-600:100-300,300-600:300-600,300-600:600-1000,300-600:1000-1500,600-1000:1-100,600-1000:100-300,600-1000:300-600,600-1000:600-1000,600-1000:1000-1500
TOKENS_LIST=1-100:1-100,1-100:100-300,1-100:300-600,1-100:600-1000,1-100:1000-1500,100-300:1-100,100-300:100-300,100-300:300-600,100-300:600-1000,100-300:1000-1500,300-600:1-100,300-600:100-300,300-600:300-600,300-600:600-1000,300-600:1000-1500,600-1000:1-100,600-1000:100-300,600-1000:300-600,600-1000:600-1000,600-1000:1000-1500

# Starting value for REQ_MIN used by experiment automation
# One value per TOKENS_LIST entry, or one per WORKLOAD_MIXES mix (by index); the last
# value is reused when the list is shorter than the number of experiments.
REQ_MIN_START=256

# --- Additive experiments (optional) ---
# List of workload mixes, one sequential experiment per bracketed entry:
#   WORKLOAD_MIXES=[(1-100:1-100,0.5),(300-600:100-300,0.5)],[(1-100:1-100,0.25),(300-600:100-300,0.75)]
# Every mix is made of "(profile, alpha)" pairs, where:
#   - profile is a token interval inMin-inMax:outMin-outMax (single values are accepted: 1-100:100)
#   - alpha is the share of the requests that profile must receive inside its mix; alphas are
#     normalised to sum 1, and the same profile twice in one mix sums its alphas
# Each request draws its profile with probability alpha and its output length from that profile's
# output interval, so the mix is additive: the requests files are per profile (cached per input
# interval) and MIN/MAX_INPUT/OUTPUT_TOKENS stay empty in results.csv (see WORKLOAD_MIX).
# When WORKLOAD_MIXES is set, TOKENS_LIST is ignored: one full experiment is run per mix,
# sequentially, and results are archived under
# <RESULTS_DIR>/Experiment_MIX_<EXPERIMENT_TYPE>_<timestamp>/mix_.../<timestamp>/.
#WORKLOAD_MIXES=[(1-100:1-100,0.5),(300-600:100-300,0.5)],[(1-100:1-100,0.25),(300-600:100-300,0.75)]

# Multiplicative factor to increase REQ_MIN on successful evaluation in stage 1
REQ_MIN_INCREASE_MULTIPLIER=2.0

# Stop-threshold semantics for stage 2 binary search.
# Supported values: relative or absolute
THRESHOLD_TYPE=relative

# Stage 2 stop threshold value.
# If THRESHOLD_TYPE=relative: stop when M - m <= M * STOP_THRESHOLD
# If THRESHOLD_TYPE=absolute: stop when M - m <= STOP_THRESHOLD
STOP_THRESHOLD=0.05

# experiment iteration duration
DURATION=1800s

# wait time in seconds between iterations
ITERATION_COOLDOWN_SECONDS=300

# Maximum number of iterations allowed per token-interval experiment
# Default behavior: stop after this many iterations (hard limit)
ITERATION_HARD_LIMIT=15

# Buffer second filter
FILTER_BUFFER=300

# Success rate threshold
SUCCESS_RATE=95

# Timeouts
REQUEST_TIMEOUT=300
TTFT_TIMEOUT=300
TPOT_TIMEOUT=300

# --- variables that change automatically ---
# minimum number of input tokens
MIN_INPUT_TOKENS=2048

# maximum number of inputs tokens
MAX_INPUT_TOKENS=2048

# minimum number of output tokens
MIN_OUTPUT_TOKENS=2048

# maximum number of output tokens
MAX_OUTPUT_TOKENS=2048

# number of requests per minute
REQ_MIN=2048

# Path to JSONL prompts file (optional; defaults to oasst_roots_en_max1000_tokens.jsonl in project root)
PROMPTS_FILE=oasst_roots_en_max1000_tokens.jsonl

# Choose if experiment is MIT or MST
EXPERIMENT_TYPE=MST
